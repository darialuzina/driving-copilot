# Driving Copilot — environment. Copy to .env and fill in.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/driving_copilot
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/driving_copilot_test

# Telegram
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=

# LLM (OpenRouter). Deliberately NOT named OPENROUTER_API_KEY.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
ROUTER_MODEL=openai/gpt-4.1-mini
ANSWER_MODEL=mistralai/mistral-large-2512

# Domain
EXAM_DATE=
TIMEZONE=Europe/Amsterdam

# Phase 2: CBR docs stack (knowledge/ files are committed; Tavily is the live fallback)
TAVILY_API_KEY=

# DeepL API key (free, :fx suffix) — only used by scripts/build_rijprocedure_en.py
# to translate the verbatim Rijprocedure B knowledge base. Not needed at runtime.
DEEPL_API_KEY=
